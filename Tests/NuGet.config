<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Declared explicitly so a restore does not depend on whatever sources
       happen to be configured on the machine. Scoped to Tests/ because it is
       the only part of the repository that uses NuGet at all - Unity manages
       its own packages under Packages/. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
